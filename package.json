{
  "name": "wasm-zoo",
  "version": "0.16.1",
  "private": true,
  "description": "Current upstream software compiled into reproducible, generic WebAssembly distributions.",
  "type": "module",
  "scripts": {
    "catalog": "node scripts/generate-catalog.mjs",
    "check": "node scripts/validate.mjs && node scripts/check-consumer-api.mjs && node scripts/check-npm-distribution.mjs && node scripts/check-upstream-automation.mjs && node --test scripts/test-libvips-adapter.mjs && node scripts/check-doc-sync.mjs && node --test scripts/test-threaded-browser-capabilities.mjs && node --test scripts/test-browser-compatibility-snapshot.mjs && node scripts/check-browser-compat-site.mjs && node scripts/check-zstd-release-prep.mjs",
    "consumer:check": "node scripts/check-consumer-api.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "build:site": "node scripts/generate-catalog.mjs && npm run check",
    "stage:playground": "node scripts/stage-local-playground.mjs",
    "check:upstream:write": "node scripts/check-upstream.mjs --write-site",
    "candidate:prepare": "node scripts/prepare-candidate.mjs",
    "health:release": "node scripts/check-release-health.mjs",
    "health:release:write": "node scripts/check-release-health.mjs --write-site",
    "metadata:check": "node scripts/check-metadata-contract.mjs",
    "promotion:prepare": "node scripts/prepare-promotion.mjs",
    "npm:prepare": "node scripts/prepare-npm-package.mjs",
    "npm:check": "node scripts/check-npm-distribution.mjs",
    "npm:smoke:jq": "node scripts/smoke-npm-package.mjs --slug jq",
    "npm:smoke": "node scripts/smoke-npm-package.mjs",
    "npm:smoke:libarchive": "node scripts/smoke-npm-package.mjs --slug libarchive",
    "npm:smoke:imagemagick": "node scripts/smoke-npm-package.mjs --slug imagemagick",
    "npm:smoke:ghostscript": "node scripts/smoke-npm-package.mjs --slug ghostscript",
    "npm:smoke:libvips": "node scripts/smoke-npm-package.mjs --slug libvips",
    "npm:smoke:ffmpeg": "node scripts/smoke-npm-package.mjs --slug ffmpeg",
    "promotion:check": "node scripts/check-upstream-automation.mjs",
    "promotion:rehearse": "node scripts/rehearse-upstream-promotions.mjs",
    "docs:check": "node scripts/check-doc-sync.mjs",
    "compat:threaded:test": "node --test scripts/test-threaded-browser-capabilities.mjs",
    "compat:publish:site": "node scripts/publish-browser-compatibility.mjs",
    "zstd:release:check": "node scripts/check-zstd-release-prep.mjs",
    "zstd:playground:smoke": "node scripts/smoke-zstd-playground.mjs",
    "npm:smoke:zstd": "node scripts/smoke-npm-package.mjs --slug zstd",
    "npm:zstd:verify-release": "node scripts/verify-npm-zstd-release.mjs"
  }
}
