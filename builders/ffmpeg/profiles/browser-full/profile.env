PROFILE_DISPLAY_NAME="Browser Full"
PROFILE_USE_X264=0
PROFILE_BINARY_LICENSE="LGPL-2.1-or-later"
PROFILE_OUTPUT_DESCRIPTION="Broad upstream ffmpeg CLI build using FFmpeg built-in codecs, formats and filters that compile for Emscripten."
PROFILE_REQUIRED_CONFIG=(
  CONFIG_FFMPEG
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_AAC_DECODER
  CONFIG_AAC_ENCODER
  CONFIG_MOV_DEMUXER
  CONFIG_MATROSKA_DEMUXER
  CONFIG_MP4_MUXER
  CONFIG_SCALE_FILTER
  CONFIG_FILE_PROTOCOL
)
