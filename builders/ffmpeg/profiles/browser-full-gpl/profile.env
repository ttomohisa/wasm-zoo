PROFILE_DISPLAY_NAME="Browser Full GPL"
PROFILE_USE_X264=1
PROFILE_BINARY_LICENSE="GPL-2.0-or-later"
PROFILE_OUTPUT_DESCRIPTION="Browser Full plus GPL-enabled FFmpeg components and libx264 H.264 encoding."
PROFILE_REQUIRED_CONFIG=(
  CONFIG_FFMPEG
  CONFIG_GPL
  CONFIG_LIBX264
  CONFIG_LIBX264_ENCODER
  CONFIG_H264_DECODER
  CONFIG_HEVC_DECODER
  CONFIG_AAC_ENCODER
  CONFIG_MOV_DEMUXER
  CONFIG_MP4_MUXER
  CONFIG_SCALE_FILTER
  CONFIG_FILE_PROTOCOL
)
